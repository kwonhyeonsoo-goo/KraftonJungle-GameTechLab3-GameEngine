<rml>
<head>
    <link type="text/rcss" href="LoadingHUD.rcss" />
</head>
<body>
    <div id="loadingRoot" data-ui-type="Canvas" data-ui-name="Loading HUD">
        <div id="loadingTitle" data-ui-type="Text" data-ui-name="Loading Label">Loading</div>
        <div id="loadingTip" data-ui-type="Text" data-ui-name="Tip">Tip: Hold your breath only when the shot really matters.</div>
        <div id="pressPrompt" data-ui-type="Text" data-ui-name="Press Space">Press Space to Play</div>
    </div>
</body>
</rml>
