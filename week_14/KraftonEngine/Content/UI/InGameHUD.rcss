#btnPauseMouseDown:hover,
#btnPauseGamepadDown:hover,
#btnPauseBgmUp:hover,
#btnPauseSfxUp:hover,
#btnPauseMouseUp:hover,
#btnPauseGamepadUp:hover,
#btnPauseZoomMode:hover {
    background-color: rgba(94, 78, 44, 240);
    color: rgba(255, 223, 134, 255);
}

#pauseControlAim,
#pauseControlScope,
#pauseControlFire,
#pauseControlBreath,
#pauseControlZoom,
#pauseControlAmmo,
#pauseControlReload,
#pauseControlPause {
    position: absolute;
    left: 44.000000px;
    width: 382.000000px;
    height: 36.000000px;
    color: rgba(226, 232, 235, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 6.000000px 18.000000px 0px 18.000000px;
    font-family: "Nexon";
    font-size: 19.000000px;
    font-weight: 700;
    text-align: left;
}

#pauseControlAim { top: 132.000000px; }
#pauseControlScope { top: 184.000000px; }
#pauseControlFire { top: 236.000000px; }
#pauseControlBreath { top: 288.000000px; }
#pauseControlZoom { top: 340.000000px; }
#pauseControlAmmo { top: 392.000000px; }
#pauseControlReload { top: 444.000000px; }
#pauseControlPause { top: 496.000000px; }
