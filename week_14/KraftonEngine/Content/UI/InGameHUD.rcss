body {
    margin: 0px;
    width: 100%;
    height: 100%;
    font-family: sans-serif;
    color: rgba(255, 255, 255, 255);
}

#hudRoot {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#compassImage {
    position: absolute;
    left: 50%;
    top: 18px;
    width: 720px;
    height: 50px;
    margin-left: -360px;
    opacity: 1;
    pointer-events: none;
}

#scopeOverlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
}

#scopeImage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 760px;
    height: 760px;
    margin-left: -380px;
    margin-top: -380px;
    opacity: 1;
    pointer-events: none;
}
