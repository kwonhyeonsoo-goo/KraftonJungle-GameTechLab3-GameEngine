body {
    margin: 0px;
    width: 1920.000000px;
    height: 1080.000000px;
}

#mainRoot {
    position: relative;
    left: 0px;
    top: 0px;
    width: 100.000000%;
    height: 100.000000%;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(238, 243, 246, 255);
    border-width: 0px;
    padding: 0px;
    font-size: 24.000000px;
    text-align: left;
}

#mainMenu {
    position: absolute;
    left: 96.000000px;
    top: 640.000000px;
    width: 420.000000px;
    height: 440.000000px;
    box-sizing: border-box;
    overflow: visible;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 0px;
}

.menu-button {
    position: relative;
    display: block;
    width: 420.000000px;
    height: 62.000000px;
    margin: 0px 0px 10px 0px;
    box-sizing: border-box;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(255, 255, 255, 0);
    border-width: 0px;
    padding: 0px;
    color: rgba(226, 232, 235, 230);
    font-family: "Nexon";
    font-weight: 700;
    font-size: 42.000000px;
    text-align: left;
    transform: scale(1.0);
    transform-origin: left center;
}

.menu-button:hover {
    color: rgba(255, 213, 118, 255);
    transform: scale(1.08);
}

.menu-button:hover .menu-button-label {
    color: rgba(255, 213, 118, 255);
}

.menu-button.primary {
    font-size: 42.000000px;
    margin: 0px 0px 18px 0px;
}

.menu-button.secondary {
    font-size: 33.600000px;
}

.menu-button-label {
    display: block;
    width: 100.000000%;
    height: 100.000000%;
    opacity: 1;
    color: rgba(226, 232, 235, 230);
}

#logoSlot {
    position: absolute;
    right: 92.000000px;
    top: 72.000000px;
    width: 360.000000px;
    height: 120.000000px;
    box-sizing: border-box;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(255, 255, 255, 0);
    border-width: 0px;
}

#versionLabel {
    position: absolute;
    right: 54.000000px;
    bottom: 34.000000px;
    width: 220.000000px;
    height: 32.000000px;
    box-sizing: border-box;
    opacity: 0.78;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 0px;
    color: rgba(218, 222, 224, 210);
    font-family: "Nexon";
    font-size: 22.000000px;
    text-align: right;
}
